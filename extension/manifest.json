{
  "manifest_version": 3,
  "name": "CyberShield — Phishing Protection",
  "short_name": "CyberShield",
  "version": "1.0.0",
  "description": "Real-time phishing and scam-site protection, powered by the CyberShield URL Security Engine.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "CyberShield"
  },
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "src/shared/browser-api.js",
        "src/shared/constants.js",
        "src/content/warning-styles.js",
        "src/content/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "notifications", "alarms", "webNavigation", "tabs", "cookies"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "minimum_chrome_version": "116"
}
