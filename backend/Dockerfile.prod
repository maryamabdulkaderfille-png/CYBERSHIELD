# Production image: no --debug flag, no bind-mounted source, runs under
# gunicorn instead of Flask's development server. Uses the same
# requirements.txt as the dev image (requirements-dev.txt only adds
# test-only packages, which have no place in a production image).
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq-dev gcc g++ unixodbc-dev libzbar0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN useradd --create-home --uid 1000 cybershield \
    && chown -R cybershield:cybershield /app
USER cybershield

EXPOSE 5000

CMD ["gunicorn", "--bind=0.0.0.0:5000", "--workers=2", "--timeout=120", "--access-logfile=-", "--error-logfile=-", "wsgi:app"]
