# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- PostgreSQL ---
POSTGRES_USER=cybershield
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=cybershield
POSTGRES_PORT=5433

# --- Backend (Flask) ---
FLASK_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
DATABASE_URL=postgresql+psycopg2://cybershield:change-me-strong-password@postgres:5432/cybershield
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
JWT_COOKIE_SECURE=false
BACKEND_PORT=5000
# Only set to true if this app sits behind a reverse proxy/load balancer you
# control (e.g. nginx, an ALB) — it makes rate limiting trust the
# X-Forwarded-For header for the client IP instead of the raw socket peer.
TRUST_PROXY_HEADERS=false
# Comma-separated allow-list of chrome-extension://<id> / moz-extension://<id>
# origins for the CyberShield browser extension (see extension/README or the
# main README's Phase 6 section). Load the unpacked extension in Chrome,
# copy its id from chrome://extensions, and set e.g.:
# EXTENSION_ORIGINS=chrome-extension://<your-extension-id>
EXTENSION_ORIGINS=

# --- Threat Intelligence (optional — live VirusTotal reputation check) ---
VIRUSTOTAL_API_KEY=
# URLhaus (abuse.ch) — free API key required at https://urlhaus.abuse.ch/api/
# Without it, the URLhaus check reports as "unavailable" rather than being
# skipped silently or (incorrectly) treated as a clean result.
URLHAUS_AUTH_KEY=

# --- Google Sign-In (optional — additive alternative to email/password) ---
# Leave both empty to leave Google Sign-In disabled entirely (the existing
# email/password flow is unaffected either way). To enable: create an OAuth
# client in Google Cloud Console (APIs & Services > Credentials > OAuth
# client ID > Web application), add an Authorized redirect URI of exactly
# {your backend origin}/api/v1/auth/google/callback (e.g.
# http://localhost:5000/api/v1/auth/google/callback for local dev), then
# paste the generated values below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email delivery (password reset / email verification) ---
# "console" (default) logs the verification/reset link to the backend
# console instead of sending real email — fine for local dev, useless for
# real users. Set to "smtp" and fill in the fields below to send real email
# through any SMTP provider (Gmail, SendGrid, Amazon SES, Mailgun, your own
# Postfix, ...).
MAIL_BACKEND=console
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_FROM=CyberShield <no-reply@cybershield.local>
# Max verification emails a single account can trigger via
# /auth/resend-verification per rolling hour (abuse guard).
VERIFICATION_RESEND_MAX_PER_HOUR=3
# How long an email-verification link stays valid.
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:5000/api/v1
FRONTEND_PORT=5173
