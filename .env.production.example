# Production environment template — copy to .env.production and fill in
# real values before using docker-compose.prod.yml. Never commit the real
# .env.production file. See the README's "Deployment (production)" section
# for the full walkthrough and what each of these actually controls.

# --- PostgreSQL ---
POSTGRES_USER=cybershield
POSTGRES_PASSWORD=replace-with-a-strong-generated-password
POSTGRES_DB=cybershield

# --- Backend (Flask) ---
FLASK_ENV=production
# Generate both with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-strong-random-value
JWT_SECRET_KEY=replace-with-a-different-strong-random-value
FRONTEND_ORIGIN=https://your-production-domain.example
FRONTEND_BASE_URL=https://your-production-domain.example
BACKEND_PORT=5000

# Real, HTTPS cookies in production — do not set this to false unless you
# genuinely understand you're disabling a core session-security control.
JWT_COOKIE_SECURE=true

# Only set to true if this app sits behind a reverse proxy/load balancer you
# control (nginx, an ALB, Cloudflare, ...) that sets X-Forwarded-For/-Proto —
# otherwise a client could spoof their own rate-limit identity.
TRUST_PROXY_HEADERS=true

# Comma-separated allow-list of chrome-extension://<id> / moz-extension://<id>
# origins for the CyberShield browser extension — leave empty if you aren't
# shipping the extension against this deployment.
EXTENSION_ORIGINS=

# In-memory (the dev default) only rate-limits per-process — with multiple
# gunicorn workers or replicas, each worker keeps its own counter, so real
# limits are effectively (configured limit x worker count). For a real
# multi-worker/multi-replica production deployment, point this at a shared
# store instead, e.g.: RATELIMIT_STORAGE_URI=redis://redis:6379/0
RATELIMIT_STORAGE_URI=memory://

# Console logging (the dev default) just prints emails to the backend log —
# fine for a thesis/demo deployment, not for real users. Set MAIL_BACKEND to
# "smtp" and fill in the fields below to send real verification/reset email
# through an SMTP provider (Gmail, SendGrid, Amazon SES, Mailgun, your own
# Postfix, ...). Never commit real credentials — this is a template only.
MAIL_BACKEND=console
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_FROM=CyberShield <no-reply@your-production-domain.example>
# Max verification emails a single account can trigger via
# /auth/resend-verification per rolling hour (abuse guard).
VERIFICATION_RESEND_MAX_PER_HOUR=3
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24

# --- Frontend (Vite) ---
# NOTE: this is consumed as a Docker build ARG (docker-compose.prod.yml),
# not a container runtime environment variable — Vite inlines it into the
# static bundle at `vite build` time. Changing it requires rebuilding the
# frontend image, not just restarting the container.
VITE_API_BASE_URL=https://your-production-domain.example/api/v1
FRONTEND_PORT=5173
